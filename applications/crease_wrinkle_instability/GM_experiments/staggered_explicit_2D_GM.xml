<?xml version="1.0" encoding="UTF-8"?>
<!--
  2D staggered explicit dielectric-elastomer crease/wrinkle test,
  replicating Seifi & Park 2016 IJSS section 4.2 ("Surface creasing
  in constrained 2D strip").

  Geometry (from paper): 80 x 4 DE film, square unit-edge elements
  -> 80 x 4 = 320 quad4 elements, 405 nodes.

  Material (paper section 4.1): mu = epsilon = rho = 1, lambda = 1000
  (nearly incompressible neo-Hookean, kappa = 1000.67).

  Two-field staggered scheme:
    Pass 1 (static)             : diffusion solves div(eps grad Psi) = 0
                                  (linear, MUMPS factorization cached)
    Pass 2 (central_difference) : updated_lagrangian_Q1P0_surface with
                                  lumped mass and diagonal solver;
                                  SimoQ1P0 base adds Maxwell stress,
                                  surface_tension sub-list adds the
                                  Young-Laplace force on side set 1.

  Loading sequence (paper section 4):
    1. Surface tension gamma ramps from 0 to target over t in [0, t_0=20].
    2. Voltage applied via schedule y(t) = t and BC value = V_dot,
       so V(t) = V_dot * t.  Early V (t < 20) is well below V_crit
       because gamma is dominant -> system equilibrates with surface
       tension first, instability nucleates only when V crosses V_crit.

  CFL: c_p = sqrt((lambda + 2 mu)/rho) = sqrt(1002) ~ 31.66
       h_min = dx = dy = 1.0 -> dt_CFL ~ 1/31.66 = 0.0316
       Choose dt = 0.02 (CFL ratio 0.63, comfortable margin).

  Voltage ramp parameters for the gamma_bar = gamma/(mu*H) = 5
  WRINKLE case (gamma = 20, H = 4):
    Analytic wrinkle threshold (Wang-Zhao 2013 in the paper's eq. 15):
      E_wrinkle ~ 2.49 sqrt(mu/eps) + 0.46 sqrt(gamma/(H*eps))
               = 2.49 + 0.46 sqrt(20/4) = 2.49 + 1.03 = 3.52
      V_wrinkle = E_wrinkle * H ~ 14.0

    V_dot = 0.05 -> V_f at end = 0.05 * t_f.  Target V_f ~ 18 to give
    headroom past V_wrinkle.  num_steps = 18000 * dt(0.02) = t_f = 360
    -> V_f = 18.  output_inc = 60 -> 300 frames.

  To return to the CREASE case (gamma_bar = 0.5, V_crease ~ 9.4)
  set gamma = 2.0 and num_steps = 15000.
-->
<tahoe author="samansei" compute_IC="false"
    geometry_file="../meshes/bar_2D.geom" output_format="ExodusII"
    title="#55 GM 2D Staggered Explicit DE Wrinkle (gamma=20, E_s=10)"
    xmlns:x0="http://www.w3.org/2001/XMLSchema">

    <time num_steps="18000" output_inc="60" time_step="0.02">
        <schedule_function>
            <piecewise_linear>
                <OrderedPair x="0" y="0"/>
                <OrderedPair x="10000000" y="10000000"/>
            </piecewise_linear>
        </schedule_function>
    </time>

    <nodes>
        <!-- Pass 1: electrostatics (static, linear) -->
        <field field_name="electric_scalar_potential" integrator="static" solution_group="1">
            <dof_labels>
                <String value="Psi"/>
            </dof_labels>
            <kinematic_BC dof="1" node_ID="1" type="fixed"/>
            <kinematic_BC dof="1" node_ID="2" schedule="1" type="u" value="0.05"/>
        </field>

        <!-- Pass 2: mechanics (explicit central difference) -->
        <field field_name="displacement" integrator="central_difference" solution_group="2">
            <dof_labels>
                <String value="D_X"/>
                <String value="D_Y"/>
            </dof_labels>
            <kinematic_BC dof="1" node_ID="1" type="fixed"/>
            <kinematic_BC dof="2" node_ID="1" type="fixed"/>
            <kinematic_BC dof="1" node_ID="3" type="fixed"/>
            <kinematic_BC dof="1" node_ID="4" type="fixed"/>
        </field>
    </nodes>

    <element_list>
        <!-- Pass 1: linear-dielectric Poisson solve -->
        <diffusion field_name="electric_scalar_potential">
            <quadrilateral/>
            <diffusion_element_nodal_output displacement="1" coordinates="1"/>
            <diffusion_element_block>
                <block_ID_list>
                    <String value="1"/>
                </block_ID_list>
                <diffusion_material>
                    <linear_dielectric_material epsilon="1.0"/>
                </diffusion_material>
            </diffusion_element_block>
        </diffusion>

        <!-- Pass 2: explicit 2D mechanics + Maxwell stress + Young-Laplace.
             gamma = 20.0 with H = 4 gives gamma_bar = 5 (WRINKLE regime
             in Seifi-Park 2016 fig. 6b).  Drop to gamma = 2 (gamma_bar = 0.5)
             for the CREASE regime. -->
        <updated_lagrangian_Q1P0_surface
            field_name="displacement" mass_type="lumped_mass" epsilon="1.0">
            <quadrilateral/>
            <solid_element_nodal_output displacements="1" stress="1"/>
            <large_strain_element_block>
                <block_ID_list>
                    <String value="1"/>
                </block_ID_list>
                <large_strain_material_2D>
                    <RG_split_general constraint_2D="plane_strain" density="1.0">
                        <rg_eq_potential>
                            <neo-hookean kappa="1000.67" mu="1.0"/>
                        </rg_eq_potential>
                    </RG_split_general>
                </large_strain_material_2D>
            </large_strain_element_block>
            <!-- #55/#54 Gurtin-Murdoch: sigma_s(eps) = gamma_0 + E_s*eps_eng.
                 E_s = 10 corresponds to ~50% stiffness boost at 5% surface
                 strain; YL recovered with E_s=0 (see 2D_young_laplace_experiments/staggered_explicit_2D.xml). -->
            <surface_tension side_set_ID="1" gamma="20.0" t_0="20.0" E_s="10.0"/>
        </updated_lagrangian_Q1P0_surface>
    </element_list>

    <!-- Solver 1: linear electrostatics (MUMPS, one factorization reused) -->
    <linear_solver>
        <MUMPS_matrix/>
    </linear_solver>
    <!-- Solver 2: explicit central-difference (diagonal mass, no matrix solve) -->
    <linear_solver>
        <diagonal_matrix/>
    </linear_solver>

    <solver_phases max_loops="1">
        <solver_phase iterations="1" pass_iterations="0" solver="1"/>
        <solver_phase iterations="1" pass_iterations="0" solver="2"/>
    </solver_phases>
</tahoe>
