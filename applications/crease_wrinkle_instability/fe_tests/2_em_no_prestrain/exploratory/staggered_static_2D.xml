<?xml version="1.0" encoding="UTF-8"?>
<!--
  2D staggered STATIC dielectric-elastomer crease test
  (Seifi-Park 2016 IJSS replication, gamma_bar = 0.5).

  Companion to monolithic_static_2D.xml.  Same geometry, BCs, material,
  loading, and (gamma=2, gamma_bar=0.5) crease regime.  The only
  difference is the field split:

    Pass 1 (static)  : diffusion solves div(eps grad Psi) = 0 (MUMPS,
                        factorization cached after first step)
    Pass 2 (static)  : updated_lagrangian_Q1P0_surface, NONLINEAR-static
                        Newton-Raphson with MUMPS.  Maxwell stress via
                        SimoQ1P0 parent; Young-Laplace on side set 1.

  Purpose: probe whether quasi-static Newton can reach the crease
  bifurcation, or whether the Hessian goes ill-conditioned first.
  Compare against monolithic_static_2D.xml for the same load.

  Loading: V_dot = 0.05, num_steps = 15000 * dt(0.02) = 300 -> V_f = 15.
-->
<tahoe author="samansei" compute_IC="false"
    geometry_file="../../../meshes/bar_2D.geom" output_format="ExodusII"
    title="2D Staggered STATIC DE Crease (gamma_bar=0.5)"
    xmlns:x0="http://www.w3.org/2001/XMLSchema">

    <time num_steps="15000" output_inc="50" time_step="0.02">
        <schedule_function>
            <piecewise_linear>
                <OrderedPair x="0" y="0"/>
                <OrderedPair x="10000000" y="10000000"/>
            </piecewise_linear>
        </schedule_function>
    </time>

    <nodes>
        <!-- Pass 1: electrostatics (static, linear) -->
        <field field_name="electric_scalar_potential" integrator="static" solution_group="1">
            <dof_labels>
                <String value="Psi"/>
            </dof_labels>
            <kinematic_BC dof="1" node_ID="1" type="fixed"/>
            <kinematic_BC dof="1" node_ID="2" schedule="1" type="u" value="0.05"/>
        </field>

        <!-- Pass 2: mechanics (STATIC nonlinear Newton-Raphson) -->
        <field field_name="displacement" integrator="static" solution_group="2">
            <dof_labels>
                <String value="D_X"/>
                <String value="D_Y"/>
            </dof_labels>
            <kinematic_BC dof="1" node_ID="1" type="fixed"/>
            <kinematic_BC dof="2" node_ID="1" type="fixed"/>
            <kinematic_BC dof="1" node_ID="3" type="fixed"/>
            <kinematic_BC dof="1" node_ID="4" type="fixed"/>
        </field>
    </nodes>

    <element_list>
        <!-- Pass 1: linear-dielectric Poisson solve -->
        <diffusion field_name="electric_scalar_potential">
            <quadrilateral/>
            <diffusion_element_nodal_output displacement="1" coordinates="1"/>
            <diffusion_element_block>
                <block_ID_list>
                    <String value="1"/>
                </block_ID_list>
                <diffusion_material>
                    <linear_dielectric_material epsilon="1.0"/>
                </diffusion_material>
            </diffusion_element_block>
        </diffusion>

        <!-- Pass 2: static 2D mechanics + Maxwell stress + Young-Laplace.
             gamma = 2.0 with H = 4 -> gamma_bar = 0.5 (CREASE). -->
        <updated_lagrangian_Q1P0_surface
            field_name="displacement" mass_type="lumped_mass" epsilon="1.0">
            <quadrilateral/>
            <solid_element_nodal_output displacements="1" stress="1"/>
            <large_strain_element_block>
                <block_ID_list>
                    <String value="1"/>
                </block_ID_list>
                <large_strain_material_2D>
                    <RG_split_general constraint_2D="plane_strain" density="1.0">
                        <rg_eq_potential>
                            <neo-hookean kappa="1000.67" mu="1.0"/>
                        </rg_eq_potential>
                    </RG_split_general>
                </large_strain_material_2D>
            </large_strain_element_block>
            <surface_tension side_set_ID="1" gamma="2.0" t_0="20.0"/>
        </updated_lagrangian_Q1P0_surface>
    </element_list>

    <!-- Solver 1: linear electrostatics (MUMPS) -->
    <linear_solver>
        <MUMPS_matrix/>
    </linear_solver>
    <!-- Solver 2: nonlinear static mechanics (MUMPS) -->
    <nonlinear_solver abs_tolerance="1.0e-7"
        check_LHS_perturbation="1.0E-8" check_code="no_check"
        divergence_tolerance="1.0e+10" max_iterations="500" rel_tolerance="1.0e-9">
        <MUMPS_matrix/>
    </nonlinear_solver>

    <solver_phases max_loops="5">
        <solver_phase iterations="1" pass_iterations="0" solver="1"/>
        <solver_phase iterations="50" pass_iterations="0" solver="2"/>
    </solver_phases>
</tahoe>
