<?xml version="1.0" encoding="UTF-8"?>
<!--
  2D monolithic dielectric-elastomer crease/wrinkle test,
  replicating Seifi & Park 2016 IJSS section 4.2.

  Geometry: 80 x 4 DE film with unit-edge square quad4 elements
            (bar_2D.geom: Lx=80, H=4, Nx=80, Ny=4, 320 elements).

  Mechanics: bottom (y=0)  fixed   (D_X=D_Y=0)
             left   (x=0)  roller  (D_X=0)
             right  (x=Lx) roller  (D_X=0)
             top    (y=H)  free    + Young-Laplace gamma on all free edges
                                     (single coupled element handles it via
                                     the elastocapillary auto-iteration over
                                     free boundary faces)
  Electrical: bottom Psi=0 ground; top Psi = V_dot * t (linear ramp).

  Single coupled element with 3 DOF/node (D_X, D_Y, Psi).

  gamma = 2.0 with H = 4 -> gamma_bar = 0.5 (CREASE regime; paper fig. 6a).
  Bump to gamma = 8 or 20 to enter the WRINKLE regime.

  V_dot = 0.05, num_steps = 15000 * dt(0.02) = 300 -> V_f = 15
  (past the analytic V_crease ~ 9.4 for gamma_bar = 0.5; safely below
  any pull-in for this constrained geometry).
-->
<tahoe author="samansei" compute_IC="false"
    geometry_file="../meshes/bar_2D.geom" output_format="ExodusII"
    title="2D Monolithic STATIC DE Crease (Seifi-Park 2016 IJSS, gamma_bar=0.5)"
    xmlns:x0="http://www.w3.org/2001/XMLSchema">

    <time num_steps="15000" output_inc="50" time_step="0.02">
        <schedule_function>
            <piecewise_linear>
                <OrderedPair x="0" y="0"/>
                <OrderedPair x="10000000" y="10000000"/>
            </piecewise_linear>
        </schedule_function>
    </time>

    <nodes>
        <field field_name="displacement" integrator="static">
            <dof_labels>
                <String value="D_X"/>
                <String value="D_Y"/>
            </dof_labels>
            <!-- bottom (NS 1): clamp -->
            <kinematic_BC dof="1" node_ID="1" type="fixed"/>
            <kinematic_BC dof="2" node_ID="1" type="fixed"/>
            <!-- left (NS 3): roller -->
            <kinematic_BC dof="1" node_ID="3" type="fixed"/>
            <!-- right (NS 4): roller -->
            <kinematic_BC dof="1" node_ID="4" type="fixed"/>
        </field>

        <field field_name="electric_scalar_potential" integrator="static">
            <dof_labels>
                <String value="Psi"/>
            </dof_labels>
            <kinematic_BC dof="1" node_ID="1" type="fixed"/>
            <kinematic_BC dof="1" node_ID="2" schedule="1" type="u" value="0.05"/>
        </field>
    </nodes>

    <element_list>
        <dielectric_elastomer_Q1P0Elastocapillary
            electric_field_name="electric_scalar_potential"
            field_name="displacement" mass_type="lumped_mass">
            <quadrilateral/>
            <solid_element_nodal_output displacements="1"
                electric_displacement="1" electric_scalar_potential="1" stress="1"/>
            <large_strain_element_block>
                <block_ID_list>
                    <String value="1"/>
                </block_ID_list>
                <large_strain_material_2D>
                    <!-- Nearly incompressible Neo-Hookean dielectric.
                         gamma = 2 -> gamma_bar = gamma/(mu*H) = 0.5 (crease).
                         Bump to gamma = 8 (gamma_bar = 2) or
                         gamma = 20 (gamma_bar = 5) for wrinkle regime. -->
                    <Dielectric_Elastomer_Q1P02D Nrig="10000000000.0"
                        density="1.0" epsilon="1.0"
                        lambda="1000.0" mu="1.0"
                        gamma="2.0" t_0="20.0"/>
                </large_strain_material_2D>
            </large_strain_element_block>
        </dielectric_elastomer_Q1P0Elastocapillary>
    </element_list>

    <nonlinear_solver abs_tolerance="1.0e-7"
        check_LHS_perturbation="1.0E-8" check_code="no_check"
        divergence_tolerance="1.0e+10" max_iterations="500" rel_tolerance="1.0e-9">
        <MUMPS_matrix/>
    </nonlinear_solver>
</tahoe>
