<?xml version="1.0" encoding="UTF-8"?>
<!-- Necking cylinder (paper Fig 12, sec 4.3): R=10, L=50, t=1, E=189e3, nu=0.29,
     saturation hardening K=343+(680-343)(1-exp(-16.93 ep))+300 ep. Left ring fixed,
     right ring stretched +z. Membrane-dominant; thickness update ON. STAB toggled by stab_membrane/bending. -->
<tahoe geometry_file="necking.geom" title="necking cylinder" output_format="ExodusII">
    <time num_steps="6000" output_inc="300" time_step="0.05">
        <schedule_function><piecewise_linear>
            <OrderedPair x="0.0" y="0.0"/><OrderedPair x="300.0" y="1.0"/>
        </piecewise_linear></schedule_function>
    </time>
    <nodes>
        <field field_name="displacement" integrator="central_difference">
            <dof_labels><String value="D_X"/><String value="D_Y"/><String value="D_Z"/></dof_labels>
            <kinematic_BC dof="1" node_ID="1"/><kinematic_BC dof="2" node_ID="1"/><kinematic_BC dof="3" node_ID="1"/>
            <kinematic_BC dof="1" node_ID="2"/><kinematic_BC dof="2" node_ID="2"/>
            <kinematic_BC dof="3" node_ID="2" schedule="1" type="u" value="15.0"/>
        </field>
    </nodes>
    <element_list>
        <meshfree_kl_shell field_name="displacement"
            shell_thickness="1.0" Young_modulus="189.0e3" Poisson_ratio="0.29"
            support_factor="2.4" completeness="2"
            density="7800.0" stab_membrane="20.0" stab_bending="20.0"
            yield_stress="343.0" hardening_modulus="300.0" yield_saturation="680.0" saturation_rate="16.93"
            finite_strain="1" thickness_update="1" monitor_node="1951" monitor_stride="1" monitor_count="50"/>
    </element_list>
    <linear_solver><diagonal_matrix/></linear_solver>
</tahoe>
