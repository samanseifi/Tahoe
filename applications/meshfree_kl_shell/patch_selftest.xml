<?xml version="1.0" encoding="UTF-8"?>
<!-- Stabilization unit test on a flat 11x11 patch. The self-test (KLSHELL_SELFTEST env) runs during
     element setup and prints the strain energy of rigid/linear/hourglass modes. All nodes pinned so
     the trivial solve doesn't matter. -->
<tahoe geometry_file="patch.geom" title="stab self-test patch">
    <time num_steps="1" output_inc="1" time_step="1.0">
        <schedule_function><piecewise_linear>
            <OrderedPair x="0.0" y="0.0"/><OrderedPair x="1.0" y="1.0"/>
        </piecewise_linear></schedule_function>
    </time>
    <nodes>
        <field field_name="displacement">
            <dof_labels><String value="D_X"/><String value="D_Y"/><String value="D_Z"/></dof_labels>
            <kinematic_BC dof="1" node_ID="9"/>
            <kinematic_BC dof="2" node_ID="9"/>
            <kinematic_BC dof="3" node_ID="9"/>
        </field>
    </nodes>
    <element_list>
        <meshfree_kl_shell field_name="displacement"
            shell_thickness="3.0" Young_modulus="3.0e3" Poisson_ratio="0.3"
            support_factor="2.4" completeness="2"
            stab_membrane="0.0" stab_bending="0.0"/>
    </element_list>
    <linear_solver><profile_matrix/></linear_solver>
</tahoe>
