<?xml version="1.0" encoding="UTF-8"?>
<!-- Setup probe: does the inherited meshfree setup accept a SURFACE node cloud?
     RKShellT::RHSDriver currently throws, so this exercises TakeParameterList only. -->
<tahoe geometry_file="scordelis.geom" title="Scordelis-Lo setup probe"
       xmlns:x0="http://www.w3.org/2001/XMLSchema">

    <time num_steps="1" output_inc="1" time_step="1.0">
        <schedule_function>
            <piecewise_linear>
                <OrderedPair x="0.0" y="0.0"/>
                <OrderedPair x="1.0" y="1.0"/>
            </piecewise_linear>
        </schedule_function>
    </time>

    <nodes>
        <field field_name="displacement">
            <dof_labels>
                <String value="D_X"/>
                <String value="D_Y"/>
                <String value="D_Z"/>
            </dof_labels>
            <!-- diaphragms: u_x = u_y = 0 at both ends; u_z restrained at one node -->
            <kinematic_BC dof="1" node_ID="1"/>
            <kinematic_BC dof="2" node_ID="1"/>
            <kinematic_BC dof="1" node_ID="2"/>
            <kinematic_BC dof="2" node_ID="2"/>
            <kinematic_BC dof="3" node_ID="3"/>
        </field>
    </nodes>

    <element_list>
        <meshfree_kl_shell field_name="displacement" shell_thickness="0.25">
            <quadrilateral num_ip="4"/>
            <solid_element_nodal_output displacements="1"/>
            <large_strain_element_block>
                <block_ID_list><String value="1"/></block_ID_list>
                <large_strain_material_3D>
                    <Simo_isotropic density="1.0">
                        <E_and_nu Poisson_ratio="0.0" Young_modulus="4.32e8"/>
                    </Simo_isotropic>
                </large_strain_material_3D>
            </large_strain_element_block>
            <meshfree_support_3D>
                <RKPM>
                    <cubic_spline_window support_scaling="1.5"/>
                </RKPM>
            </meshfree_support_3D>
            <meshfree_fracture_support>
                <interpolant_node_ID_list>
                    <String value="9"/>
                </interpolant_node_ID_list>
            </meshfree_fracture_support>
        </meshfree_kl_shell>
    </element_list>

    <linear_solver>
        <profile_matrix/>
    </linear_solver>
</tahoe>
