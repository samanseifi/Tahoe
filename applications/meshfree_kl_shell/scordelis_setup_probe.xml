<?xml version="1.0" encoding="UTF-8"?>
<!-- Setup probe for the reparented (ElementBaseT) meshfree_kl_shell: does it CONSTRUCT on a
     surface node cloud? (RHSDriver still staged, so this exercises TakeParameterList only.) -->
<tahoe geometry_file="scordelis.geom" title="Scordelis-Lo setup probe (ElementBaseT)"
       xmlns:x0="http://www.w3.org/2001/XMLSchema">

    <time num_steps="1" output_inc="1" time_step="1.0">
        <schedule_function>
            <piecewise_linear>
                <OrderedPair x="0.0" y="0.0"/>
                <OrderedPair x="1.0" y="1.0"/>
            </piecewise_linear>
        </schedule_function>
    </time>

    <nodes>
        <field field_name="displacement">
            <dof_labels>
                <String value="D_X"/>
                <String value="D_Y"/>
                <String value="D_Z"/>
            </dof_labels>
            <!-- diaphragms: u_x = u_y = 0 at both ends; u_z restrained at one node -->
            <kinematic_BC dof="1" node_ID="1"/>
            <kinematic_BC dof="2" node_ID="1"/>
            <kinematic_BC dof="1" node_ID="2"/>
            <kinematic_BC dof="2" node_ID="2"/>
            <kinematic_BC dof="3" node_ID="3"/>
        </field>
    </nodes>

    <element_list>
        <meshfree_kl_shell field_name="displacement"
            shell_thickness="0.25" Young_modulus="4.32e8" Poisson_ratio="0.0"
            support_factor="3.0" completeness="3"/>
    </element_list>

    <linear_solver>
        <profile_matrix/>
    </linear_solver>
</tahoe>
