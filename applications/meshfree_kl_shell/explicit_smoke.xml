<?xml version="1.0" encoding="UTF-8"?>
<!-- Explicit central-difference smoke test for meshfree_kl_shell: verifies the lumped mass
     (FormM) + internal force (RHSDriver) integrate through Tahoe's explicit solver.
     Elastic, pinched-cylinder geometry, mass-scaled (high density) for a usable time step. -->
<tahoe geometry_file="pinched.geom" title="meshfree_kl_shell explicit smoke"
       xmlns:x0="http://www.w3.org/2001/XMLSchema">

    <time num_steps="50" output_inc="50" time_step="1.0e-4">
        <schedule_function>
            <piecewise_linear>
                <OrderedPair x="0.0" y="0.0"/>
                <OrderedPair x="1.0" y="1.0"/>
            </piecewise_linear>
        </schedule_function>
    </time>

    <nodes>
        <field field_name="displacement" integrator="central_difference">
            <dof_labels>
                <String value="D_X"/>
                <String value="D_Y"/>
                <String value="D_Z"/>
            </dof_labels>
            <kinematic_BC dof="1" node_ID="1"/>
            <kinematic_BC dof="2" node_ID="1"/>
            <kinematic_BC dof="1" node_ID="2"/>
            <kinematic_BC dof="2" node_ID="2"/>
            <kinematic_BC dof="3" node_ID="5"/>
            <force_BC dof="1" node_ID="3" schedule="1" value="-1.0"/>
            <force_BC dof="1" node_ID="4" schedule="1" value="1.0"/>
        </field>
    </nodes>

    <element_list>
        <meshfree_kl_shell field_name="displacement"
            shell_thickness="3.0" Young_modulus="3.0e6" Poisson_ratio="0.3"
            support_factor="3.0" completeness="3" density="7800.0"/>
    </element_list>

    <linear_solver><diagonal_matrix/></linear_solver>
</tahoe>
