<?xml version="1.0" encoding="UTF-8"?>
<!-- Pinched cylinder with end diaphragms (linear elastic), meshfree_kl_shell.
     R=300 L=600 t=3 E=3e6 nu=0.3, two diametric unit point loads at mid-length.
     Reference radial deflection under the load = 1.8248e-5 (bending-dominated).

     STATUS (not yet converged -- known open problem): this is the thin-shell, bending-
     dominated, inextensional case. Use a BALANCED mesh (generate_pinched_geom.py auto-balances
     nz from nt) so the isotropic kernel support couples in both directions. Quadratic
     hourglasses (too soft, grows with refinement). Cubic (completeness=3) controls the
     hourglass and reproduces the prototype's ~5x result (max|u| ~ 9.1e-5 at nt=36 vs ref
     1.8248e-5), but the cubic moment matrix is fragile on structured grids (zero-diagonal /
     blow-up at some nt). Full convergence needs the paper's section 5.2 thin-shell membrane
     stabilization (SCNI-style smoothed gradient) -- the paper's acknowledged preliminary work.
     Run with: python3 generate_pinched_geom.py 36 > pinched.geom  (nt=36, cubic). -->
<tahoe geometry_file="pinched.geom" title="Pinched cylinder (meshfree_kl_shell)"
       xmlns:x0="http://www.w3.org/2001/XMLSchema">

    <time num_steps="1" output_inc="1" time_step="1.0">
        <schedule_function>
            <piecewise_linear>
                <OrderedPair x="0.0" y="0.0"/>
                <OrderedPair x="1.0" y="1.0"/>
            </piecewise_linear>
        </schedule_function>
    </time>

    <nodes>
        <field field_name="displacement">
            <dof_labels>
                <String value="D_X"/>
                <String value="D_Y"/>
                <String value="D_Z"/>
            </dof_labels>
            <!-- end diaphragms (sets 1,2): u_x = u_y = 0 -->
            <kinematic_BC dof="1" node_ID="1"/>
            <kinematic_BC dof="2" node_ID="1"/>
            <kinematic_BC dof="1" node_ID="2"/>
            <kinematic_BC dof="2" node_ID="2"/>
            <!-- remove axial rigid-body mode: u_z = 0 at one node (set 5) -->
            <kinematic_BC dof="3" node_ID="5"/>
            <!-- two diametric inward unit point loads at mid-length -->
            <force_BC dof="1" node_ID="3" schedule="1" value="-1.0"/>
            <force_BC dof="1" node_ID="4" schedule="1" value="1.0"/>
        </field>
    </nodes>

    <element_list>
        <meshfree_kl_shell field_name="displacement"
            shell_thickness="3.0" Young_modulus="3.0e6" Poisson_ratio="0.3"
            support_factor="3.0" completeness="3"/>
    </element_list>

    <linear_solver>
        <profile_matrix/>
    </linear_solver>
</tahoe>
