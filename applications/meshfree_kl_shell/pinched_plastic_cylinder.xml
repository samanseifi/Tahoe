<?xml version="1.0" encoding="UTF-8"?>
<!-- Fig 18: elasto-plastic pinched cylinder crush (finite deformation), displacement-controlled,
     explicit central-difference. R=300, L=600, h=3, E=3e6, nu=0.3. The two diametric mid-length
     points (node sets 3,4) are driven inward; the reaction at the load point vs its displacement
     is the load-displacement curve.

     REQUIRES a 40-circumferential mesh:  python3 generate_pinched_geom.py 40 > pinched.geom
       -> load point A = global node 281 (set 3), B = node 301 (set 4).

     QUASI-STATIC explicit: dt MUST be near the stability limit (dt_crit ~ spacing/c, c=sqrt(E/rho)
     ~ 19.6, spacing ~ 47 for nt=40 -> dt_crit ~ 2.4; use dt=0.25). The total time (num_steps*dt =
     1000 s) must be MANY wave transits (tau = pi*R/c ~ 48 s) so the deformation propagates across
     the cylinder and the structure crushes globally (NOT a local dimple at the load points). A far
     smaller dt (e.g. 1e-6) only advances ~ms of real time -> nothing propagates -> WRONG. -->
<tahoe geometry_file="pinched.geom" title="elasto-plastic pinched cylinder crush (meshfree_kl_shell)"
       output_format="ExodusII" xmlns:x0="http://www.w3.org/2001/XMLSchema">

    <time num_steps="5000" output_inc="100" time_step="0.1">
        <schedule_function>
            <piecewise_linear>
                <OrderedPair x="0.0"    y="0.0"/>
                <OrderedPair x="500.0" y="1.0"/>
            </piecewise_linear>
        </schedule_function>
    </time>

    <nodes>
        <field field_name="displacement" integrator="central_difference">
            <dof_labels>
                <String value="D_X"/>
                <String value="D_Y"/>
                <String value="D_Z"/>
            </dof_labels>
            <kinematic_BC dof="1" node_ID="1"/>
            <kinematic_BC dof="2" node_ID="1"/>
            <kinematic_BC dof="1" node_ID="2"/>
            <kinematic_BC dof="2" node_ID="2"/>
            <kinematic_BC dof="3" node_ID="5"/>
            <kinematic_BC dof="1" node_ID="7" schedule="1" type="u" value="-200.0"/>
            <kinematic_BC dof="1" node_ID="8" schedule="1" type="u" value="200.0"/>
        </field>
    </nodes>

    <element_list>
        <meshfree_kl_shell field_name="displacement"
            shell_thickness="3.0" Young_modulus="3.0e6" Poisson_ratio="0.3"
            support_factor="3.0" completeness="2"
            density="7800.0" stab_membrane="20.0" stab_bending="10.0"
            yield_stress="2.4e4" hardening_modulus="3.0e5"
            finite_strain="1" monitor_node="4161"/>
    </element_list>

    <linear_solver><diagonal_matrix/></linear_solver>
</tahoe>
