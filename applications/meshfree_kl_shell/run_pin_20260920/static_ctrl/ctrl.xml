<?xml version="1.0" encoding="UTF-8"?>
<!-- Pinched cylinder with end diaphragms (linear elastic), meshfree_kl_shell.
     R=300 L=600 t=3 E=3e6 nu=0.3, two diametric unit point loads at mid-length.
     Reference radial deflection under the load = 1.8248e-5 (bending-dominated).

     The paper uses quadratic completeness. Fresh 2026-09-16 runs with the cubic-completeness
     deck diverged under refinement (3.02x at 468 nodes to 6.87x at 2160 nodes). The corrected
     quadratic/cubic-B-spline deck reaches 0.952x at 8480 nodes. See
     pinched_current_comparison.csv and pinched_paper_comparison.svg.
     Run with: python3 generate_pinched_geom.py 160 > pinched.geom. -->
<tahoe geometry_file="pinched40.geom" title="Pinched cylinder (meshfree_kl_shell)"
       output_format="ExodusII"
       xmlns:x0="http://www.w3.org/2001/XMLSchema">

    <time num_steps="1" output_inc="1" time_step="1.0">
        <schedule_function>
            <piecewise_linear>
                <OrderedPair x="0.0" y="0.0"/>
                <OrderedPair x="1.0" y="1.0"/>
            </piecewise_linear>
        </schedule_function>
    </time>

    <nodes>
        <field field_name="displacement">
            <dof_labels>
                <String value="D_X"/>
                <String value="D_Y"/>
                <String value="D_Z"/>
            </dof_labels>
            <!-- end diaphragms (sets 1,2): u_x = u_y = 0 -->
            <kinematic_BC dof="1" node_ID="1"/>
            <kinematic_BC dof="2" node_ID="1"/>
            <kinematic_BC dof="1" node_ID="2"/>
            <kinematic_BC dof="2" node_ID="2"/>
            <!-- remove axial rigid-body mode: u_z = 0 at one node (set 5) -->
            <kinematic_BC dof="3" node_ID="5"/>
            <!-- two diametric inward unit point loads at mid-length -->
            <penalty_displacement_meshfree dof="1" schedule="1" value="-7.56010181e-06" penalty="1.0e6">
                <node_ID_list><String value="3"/></node_ID_list>
            </penalty_displacement_meshfree>
            <penalty_displacement_meshfree dof="1" schedule="1" value="7.56010181e-06" penalty="1.0e6">
                <node_ID_list><String value="4"/></node_ID_list>
            </penalty_displacement_meshfree>
        </field>
    </nodes>

    <element_list>
        <meshfree_kl_shell field_name="displacement"
            shell_thickness="3.0" Young_modulus="3.0e6" Poisson_ratio="0.3"
            support_factor="2.5" completeness="2" kernel="1"
            stab_natural="1.0" stab_bending="0.0" monitor_node="281"/>
    </element_list>

    <nonlinear_solver abs_tolerance="1.0e-14" divergence_tolerance="1.0e+03" max_iterations="10" rel_tolerance="1.0e-10"><profile_matrix/></nonlinear_solver>
</tahoe>
