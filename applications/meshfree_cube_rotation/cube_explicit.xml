<?xml version="1.0" encoding="UTF-8"?>
<!-- DIAGNOSTIC: does a KNOWN meshfree element (large_strain_meshfree = MeshFreeFSSolidT)
     integrate under the explicit central_difference solver? x=0 fixed, force on x=L face. -->
<tahoe geometry_file="cube.geom" title="meshfree cube explicit diagnostic"
       output_format="ExodusII" xmlns:x0="http://www.w3.org/2001/XMLSchema">

    <time num_steps="200" output_inc="50" time_step="1.0e-3">
        <schedule_function>
            <piecewise_linear>
                <OrderedPair x="0.0" y="0.0"/>
                <OrderedPair x="1.0" y="1.0"/>
            </piecewise_linear>
        </schedule_function>
    </time>

    <nodes>
        <field field_name="displacement" integrator="central_difference">
            <dof_labels>
                <String value="D_X"/>
                <String value="D_Y"/>
                <String value="D_Z"/>
            </dof_labels>
            <kinematic_BC dof="1" node_ID="1"/>
            <kinematic_BC dof="2" node_ID="1"/>
            <kinematic_BC dof="3" node_ID="1"/>
            <force_BC dof="2" node_ID="2" schedule="1" value="1.0"/>
        </field>
    </nodes>

    <element_list>
        <large_strain_meshfree field_name="displacement" mass_type="lumped_mass">
            <hexahedron num_ip="8"/>
            <solid_element_nodal_output displacements="1"/>
            <large_strain_element_block>
                <block_ID_list>
                    <String value="1"/>
                </block_ID_list>
                <large_strain_material_3D>
                    <Simo_isotropic density="1.0">
                        <E_and_nu Poisson_ratio="0.3" Young_modulus="100.0"/>
                    </Simo_isotropic>
                </large_strain_material_3D>
            </large_strain_element_block>
            <meshfree_support_3D>
                <RKPM>
                    <cubic_spline_window support_scaling="1.2"/>
                </RKPM>
            </meshfree_support_3D>
            <meshfree_fracture_support>
                <interpolant_node_ID_list>
                    <String value="1"/>
                    <String value="2"/>
                </interpolant_node_ID_list>
            </meshfree_fracture_support>
        </large_strain_meshfree>
    </element_list>

    <linear_solver><diagonal_matrix/></linear_solver>
</tahoe>
