<?xml version="1.0" encoding="UTF-8"?>
<!-- Meshfree (RKPM) cube, compressible Neo-Hookean (Simo_isotropic).
     x=0 face fixed; x=L face twisted 90 deg about the x-axis via an affine
     mapped-node BC  u = schedule(t) * (R_x(90)-I) * X, ramped 0->1 over the run.
     R_x(90)-I = [[0,0,0],[0,-1,-1],[0,1,-1]]. -->
<tahoe geometry_file="cube.geom" title="meshfree cube 90deg twist (Neo-Hookean)"
       output_format="ExodusII" xmlns:x0="http://www.w3.org/2001/XMLSchema">

    <time num_steps="120" output_inc="10" max_step_cuts="6" time_step="8.3333e-3">
        <schedule_function>
            <piecewise_linear>
                <OrderedPair x="0.0" y="0.0"/>
                <OrderedPair x="1.0" y="1.0"/>
            </piecewise_linear>
        </schedule_function>
    </time>

    <nodes>
        <field field_name="displacement">
            <dof_labels>
                <String value="D_X"/>
                <String value="D_Y"/>
                <String value="D_Z"/>
            </dof_labels>

            <!-- fixed face: x = 0 (node set 1) -->
            <kinematic_BC dof="1" node_ID="1"/>
            <kinematic_BC dof="2" node_ID="1"/>
            <kinematic_BC dof="3" node_ID="1"/>

            <!-- rotating face: x = L (node set 2), affine twist about x -->
            <mapped_nodes schedule="1">
                <Matrix_3x3 A_2_2="-1.0" A_2_3="-1.0" A_3_2="1.0" A_3_3="-1.0"/>
                <mapped_node_ID_list>
                    <String value="2"/>
                </mapped_node_ID_list>
            </mapped_nodes>
        </field>
    </nodes>

    <element_list>
        <large_strain_meshfree field_name="displacement">
            <hexahedron num_ip="8"/>
            <solid_element_nodal_output displacements="1" stress="1" material_output="1"/>
            <large_strain_element_block>
                <block_ID_list>
                    <String value="1"/>
                </block_ID_list>
                <large_strain_material_3D>
                    <Simo_isotropic density="1.0">
                        <E_and_nu Poisson_ratio="0.3" Young_modulus="100.0"/>
                    </Simo_isotropic>
                </large_strain_material_3D>
            </large_strain_element_block>
            <meshfree_support_3D>
                <RKPM>
                    <cubic_spline_window support_scaling="1.2"/>
                </RKPM>
            </meshfree_support_3D>
            <meshfree_fracture_support>
                <interpolant_node_ID_list>
                    <String value="1"/>
                    <String value="2"/>
                </interpolant_node_ID_list>
            </meshfree_fracture_support>
        </large_strain_meshfree>
    </element_list>

    <nonlinear_solver abs_tolerance="1.0e-8" rel_tolerance="1.0e-8"
        divergence_tolerance="1.0e+8" max_iterations="30">
        <profile_matrix/>
    </nonlinear_solver>
</tahoe>
