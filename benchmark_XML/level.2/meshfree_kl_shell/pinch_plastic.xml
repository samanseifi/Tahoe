<?xml version="1.0" encoding="UTF-8"?>
<!-- ELASTO-PLASTIC PINCHED CYLINDER (Wang & Bazilevs 2025 sec. 4.4, Fig 18; #59 #73), shortened
     regression version on a 40x15 cloud. R=300, L=600, h=3, E=3e3, nu=0.3, Y = 24.3 + 300 ep,
     rigid diaphragms (u_x=u_y=0 at the end rings), the two mid-length points driven inward to 45 mm
     by penalty_displacement_meshfree (physical displacement; the reported lambda is the physical
     point load). Mass-scaled explicit (density 7800 in mm-MPa units, dt=3); the ramp is 5x faster
     than the quasi-static validation runs, so the response here is partly inertial: this deck is a
     REGRESSION of the plastic fold (yield onset ~200 N passed, eps_p ~4% at 45 mm), not a validation.
     NOTE the literature (and the paper's Fig 18) plots the symmetry-model force = lambda/4; the
     validation on the paper's 160x53 cloud is in docs/meshfree_kl_shell/fig18_validation/. -->
<tahoe geometry_file="pinched40.geom" title="pinched cylinder, elasto-plastic (meshfree_kl_shell)">
    <time num_steps="1500" output_inc="250" time_step="3.0">
        <schedule_function><piecewise_linear>
            <OrderedPair x="0.0" y="0.0"/><OrderedPair x="30000.0" y="1.0"/>
        </piecewise_linear></schedule_function>
    </time>
    <nodes><field field_name="displacement" integrator="central_difference">
        <dof_labels><String value="D_X"/><String value="D_Y"/><String value="D_Z"/></dof_labels>
        <kinematic_BC dof="1" node_ID="1"/><kinematic_BC dof="2" node_ID="1"/>
        <kinematic_BC dof="1" node_ID="2"/><kinematic_BC dof="2" node_ID="2"/>
        <kinematic_BC dof="3" node_ID="3"/><kinematic_BC dof="3" node_ID="4"/>
        <penalty_displacement_meshfree dof="1" schedule="1" value="-300.0" penalty="1.0e5" damping_ratio="1.0">
            <node_ID_list><String value="3"/></node_ID_list>
        </penalty_displacement_meshfree>
        <penalty_displacement_meshfree dof="1" schedule="1" value="300.0" penalty="1.0e5" damping_ratio="1.0">
            <node_ID_list><String value="4"/></node_ID_list>
        </penalty_displacement_meshfree>
    </field></nodes>
    <element_list><meshfree_kl_shell field_name="displacement"
        shell_thickness="3.0" Young_modulus="3.0e3" Poisson_ratio="0.3"
        support_factor="2.4" completeness="2" kernel="1"
        density="7800.0" stab_natural="1.0" stab_siggrad="1" stab_bending="0.0"
        yield_stress="24.3" hardening_modulus="300.0"
        finite_strain="1" thickness_update="1" corotational="1" monitor_node="281"/>
    </element_list>
    <linear_solver><diagonal_matrix/></linear_solver>
</tahoe>
