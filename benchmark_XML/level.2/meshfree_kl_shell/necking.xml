<?xml version="1.0" encoding="UTF-8"?>
<!-- NECKING OF A CYLINDRICAL SHELL (Wang & Bazilevs 2025 sec. 4.3, Fig 15; #59 #73), shortened
     regression version. R=10, L=50, h=1 (24x21 nodes); J2 plasticity with saturation hardening
     Y = 343 + 300 ep + (680-343)(1-exp(-16.93 ep)), finite strain, thickness update, natural +
     stress-gradient stabilization. z=0 ring fixed; z=L ring radially clamped and pulled axially to
     10% elongation (5 mm) by a displacement ramp. Mass-scaled explicit (density x1e8, dt=2e-3):
     wave transit L/c ~ 0.1 s vs a 3 s ramp, so the response is quasi-static. Exercises the plastic
     membrane path; the full paper case (34x27 and 50x40 nodes, real density) is documented in
     docs/meshfree_kl_shell/. -->
<tahoe geometry_file="necking.geom" title="necking cylinder, elasto-plastic (meshfree_kl_shell)">
    <time num_steps="1500" output_inc="250" time_step="2.0e-3">
        <schedule_function><piecewise_linear>
            <OrderedPair x="0.0" y="0.0"/><OrderedPair x="3.0" y="1.0"/>
        </piecewise_linear></schedule_function>
    </time>
    <nodes><field field_name="displacement" integrator="central_difference">
        <dof_labels><String value="D_X"/><String value="D_Y"/><String value="D_Z"/></dof_labels>
        <kinematic_BC dof="1" node_ID="1"/><kinematic_BC dof="2" node_ID="1"/><kinematic_BC dof="3" node_ID="1"/>
        <kinematic_BC dof="1" node_ID="2"/><kinematic_BC dof="2" node_ID="2"/>
        <kinematic_BC dof="3" node_ID="2" schedule="1" type="u" value="5.0"/>
    </field></nodes>
    <element_list><meshfree_kl_shell field_name="displacement"
        shell_thickness="1.0" Young_modulus="189.0e3" Poisson_ratio="0.29"
        support_factor="2.4" completeness="2" kernel="1"
        density="0.78" stab_natural="1.0" stab_siggrad="1"
        yield_stress="343.0" hardening_modulus="300.0" yield_saturation="680.0" saturation_rate="16.93"
        finite_strain="1" thickness_update="1" monitor_node="481" monitor_stride="1" monitor_count="24"/>
    </element_list>
    <linear_solver><diagonal_matrix/></linear_solver>
</tahoe>
