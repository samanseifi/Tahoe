<?xml version="1.0" encoding="UTF-8"?>
<!-- PENALTY-DISPLACEMENT BC on the IMPLICIT path (#73): static linear pinched cylinder (obstacle
     course, reference deflection 1.8248e-5 under a unit point load) with the two pinch points driven
     to a prescribed physical displacement -/+1.0e-5 through MFPenaltyDisplacementT. Exercises the
     controller's tangent k*Phi*Phi^T and its ragged equation/connectivity sets: the linear problem
     must converge in ONE Newton iteration, and the reported lambda equals k times the constraint
     slack (~0.55 N here, i.e. the load that produces 1e-5 on this mesh). -->
<tahoe geometry_file="pinched_cyl.geom" title="penalty displacement BC, static (meshfree_kl_shell)">
    <time num_steps="1" output_inc="1" time_step="1.0">
        <schedule_function><piecewise_linear>
            <OrderedPair x="0.0" y="0.0"/><OrderedPair x="1.0" y="1.0"/>
        </piecewise_linear></schedule_function>
    </time>
    <nodes><field field_name="displacement">
        <dof_labels><String value="D_X"/><String value="D_Y"/><String value="D_Z"/></dof_labels>
        <kinematic_BC dof="1" node_ID="1"/><kinematic_BC dof="2" node_ID="1"/>
        <kinematic_BC dof="1" node_ID="2"/><kinematic_BC dof="2" node_ID="2"/>
        <kinematic_BC dof="3" node_ID="5"/>
        <penalty_displacement_meshfree dof="1" schedule="1" value="-1.0e-5" penalty="1.0e10">
            <node_ID_list><String value="3"/></node_ID_list>
        </penalty_displacement_meshfree>
        <penalty_displacement_meshfree dof="1" schedule="1" value="1.0e-5" penalty="1.0e10">
            <node_ID_list><String value="4"/></node_ID_list>
        </penalty_displacement_meshfree>
    </field></nodes>
    <element_list><meshfree_kl_shell field_name="displacement"
        shell_thickness="3.0" Young_modulus="3.0e6" Poisson_ratio="0.3"
        support_factor="2.5" completeness="2" kernel="1"
        stab_natural="1.0" stab_bending="0.0" monitor_node="601"/>
    </element_list>
    <nonlinear_solver abs_tolerance="1.0e-14" divergence_tolerance="1.0e+03" max_iterations="5" rel_tolerance="1.0e-10"><profile_matrix/></nonlinear_solver>
</tahoe>
