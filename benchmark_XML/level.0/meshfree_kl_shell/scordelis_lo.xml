<?xml version="1.0" encoding="UTF-8"?>
<!-- Scordelis-Lo roof regression for the meshfree_kl_shell element (#59).
     Membrane-dominated curved shell; analytic free-edge deflection 0.3006. The 15x15 meshfree
     solution is ~0.275 (converges toward 0.30 under refinement). This benchmark GUARDS the
     working membrane regime: any change to the element internal-force / stabilization loops that
     perturbs this clean case will show up here. Default (Tahoe) output format for `compare`. -->
<tahoe geometry_file="scordelis.geom" title="Scordelis-Lo roof (meshfree_kl_shell)"
       xmlns:x0="http://www.w3.org/2001/XMLSchema">

    <time num_steps="1" output_inc="1" time_step="1.0">
        <schedule_function>
            <piecewise_linear>
                <OrderedPair x="0.0" y="0.0"/>
                <OrderedPair x="1.0" y="1.0"/>
            </piecewise_linear>
        </schedule_function>
    </time>

    <nodes>
        <field field_name="displacement">
            <dof_labels>
                <String value="D_X"/>
                <String value="D_Y"/>
                <String value="D_Z"/>
            </dof_labels>
            <kinematic_BC dof="1" node_ID="1"/>
            <kinematic_BC dof="2" node_ID="1"/>
            <kinematic_BC dof="1" node_ID="2"/>
            <kinematic_BC dof="2" node_ID="2"/>
            <kinematic_BC dof="3" node_ID="3"/>
        </field>
    </nodes>

    <element_list>
        <meshfree_kl_shell field_name="displacement"
            shell_thickness="0.25" Young_modulus="4.32e8" Poisson_ratio="0.0"
            support_factor="3.0" completeness="2"
            load_x="0.0" load_y="-90.0" load_z="0.0"/>
    </element_list>

    <linear_solver>
        <profile_matrix/>
    </linear_solver>
</tahoe>
