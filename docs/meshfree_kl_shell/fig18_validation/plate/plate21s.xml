<tahoe geometry_file="plate21.geom" title="SS plate pressure" output_format="ExodusII" xmlns:x0="http://www.w3.org/2001/XMLSchema">
    <time num_steps="1" output_inc="1" time_step="1.0">
        <schedule_function><piecewise_linear><OrderedPair x="0.0" y="0.0"/><OrderedPair x="1.0" y="1.0"/></piecewise_linear></schedule_function>
    </time>
    <nodes>
        <field field_name="displacement">
            <dof_labels><String value="D_X"/><String value="D_Y"/><String value="D_Z"/></dof_labels>
            <kinematic_BC dof="1" node_ID="1"/>
            <kinematic_BC dof="2" node_ID="1"/>
            <kinematic_BC dof="3" node_ID="1"/>
        </field>
    </nodes>
    <element_list>
        <meshfree_kl_shell field_name="displacement" shell_thickness="1.0" Young_modulus="1000.0" Poisson_ratio="0.3"
            support_factor="2.4" completeness="2" kernel="1" stab_natural="1.0" stab_bending="0.0" yield_stress="1.0e6" hardening_modulus="0.0"
            load_z="-1.0e-3" monitor_node="221"/>
    </element_list>
    <linear_solver><profile_matrix/></linear_solver>
</tahoe>
